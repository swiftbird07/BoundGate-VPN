<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- LaunchDaemon for a permanently installed node (see docs/MACOS.md):
     /usr/local/bin/boundgate-node, /usr/local/etc/boundgate/node.yaml,
     state in /var/db/boundgate, socket /var/run/boundgate/node.sock. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.boundgate.node</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/boundgate-node</string>
    <string>-config</string>
    <string>/usr/local/etc/boundgate/node.yaml</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>ProcessType</key><string>Interactive</string>
  <key>StandardOutPath</key><string>/var/log/boundgate/node.out.log</string>
  <key>StandardErrorPath</key><string>/var/log/boundgate/node.err.log</string>
</dict>
</plist>
