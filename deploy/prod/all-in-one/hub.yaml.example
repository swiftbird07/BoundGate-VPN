# Hub on the same server as the control plane.
name: hub1
state_dir: /var/lib/boundgate
key_kind: softkey                  # tpm2 with a TPM or vTPM (docs/TPM.md)
control:
  addr: bg.example.com:443
  server_name: nodes.bg.example.com
roles: [hub]                       # requested; granted at approval. Add subnet-router / exit-node with prefixes to route beyond this host
# prefixes:
#   - {prefix: 10.0.0.0/24, mode: snat}     # e.g. a Hetzner private network behind this server
listen: "127.0.0.1:8444"           # private, behind the mux (UDP for QUIC, and TCP for the fallback)
behind_mux:
  id: 2                            # = the route's id in mux.yaml
  trusted: [127.0.0.1]
  # no_proxy_protocol: true        # if a reverse proxy in front of the TCP side sends no PROXY v2 header
# tcp_fallback: false              # UDP only: no TCP listener, and spokes never fall back
# relay: false                     # do not relay between spokes (docs/PATHS.md): they then only meet through this hub's routing
# Only for Android's Always-on VPN with "Block connections without VPN" (docs/ANDROID.md): a device
# without a user session gets a tunnel that reaches these destinations only, so that its browser
# can sign in. List the IdP's addresses and the DNS resolver the phones use.
# login_passthrough: [203.0.113.10/32, 10.20.0.1/32]
public_addr: "bg.example.com:443"  # what spokes dial: the same address and port as the control plane
auto_up: true
profile: full
socket: /run/boundgate/node.sock
tun_name: bg0
log_dir: /var/log/boundgate
log_stdout: true
