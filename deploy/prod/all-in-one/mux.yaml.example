# boundgate-mux: owns the public port 443 (TCP and UDP) and routes by TLS server
# name, without terminating TLS and without any key. Control plane and hub
# listen on loopback behind it.
listen: ":443"
routes:
  - name: control
    sni: [bg.example.com, nodes.bg.example.com]   # admin name and node-channel name of control.yaml
    id: 1                                          # = behind_mux.id in control.yaml
    udp: 127.0.0.1:8443
    tcp: 127.0.0.1:8443
  - name: hub
    sni: [hub.boundgate]                           # the name every spoke uses for a hub (fixed)
    id: 2                                          # = behind_mux.id in hub.yaml
    udp: 127.0.0.1:8444
# Something else already serves HTTPS on this machine (Caddy, Traefik, nginx)?
# Move it to another port and name it here: every other server name goes
# there untouched, TLS included.
# default_tcp: 127.0.0.1:8080
# Or keep your reverse proxy on TCP/443, let it pass bg.example.com and
# nodes.bg.example.com through by SNI (no TLS termination, PROXY protocol v2)
# to 127.0.0.1:8443, and let the mux serve UDP only:
# no_tcp: true
