# One node. Replace bg.example.com with the control plane's name.
name: router1                      # shown to admins; the hostname if empty
state_dir: /var/lib/boundgate
key_kind: softkey                  # tpm2 with a TPM or vTPM (docs/TPM.md): pass /dev/tpmrm0 in docker-compose.yml
# tpm_device: /dev/tpmrm0
control:
  addr: bg.example.com:443
  server_name: nodes.bg.example.com
# Roles are requested here and granted by the admin at approval. Pick one block:
#
# subnet router: the LAN behind this host becomes reachable through the overlay
roles: [subnet-router]
prefixes:
  - {prefix: 192.168.10.0/24, mode: snat}    # snat: no return route needed in the LAN; routed: the LAN routes the overlay pool back to this host
#
# exit node: everything (profile `full` on spokes) leaves the overlay here
# roles: [exit-node]
# prefixes:
#   - {prefix: 0.0.0.0/0, mode: snat}
#
# hub on its own server: spokes dial it directly, so it owns UDP/443 of this address
# roles: [hub]
# listen: ":443"
# public_addr: "hub2.example.com:443"
#
# workload endpoint (a server that only needs to be reached, no user login)
# roles: [endpoint]
auto_up: true                      # up as soon as approved and at every start
profile: full                      # routes everything hubs advertise. A server should not take an exit node's
                                   # 0.0.0.0/0 as its default route: put an `include` profile (docs/PROFILES.md, the
                                   # lab's deploy/compose/config/profiles/lab.yaml) into ./profiles and name it here
# profiles_dir: /etc/boundgate/profiles    # mount ./profiles:/etc/boundgate/profiles:ro in docker-compose.yml
socket: /run/boundgate/node.sock
tun_name: bg0
mtu: 1280
log_dir: /var/log/boundgate
log_stdout: true
