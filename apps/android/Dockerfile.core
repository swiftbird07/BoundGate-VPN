# Builds libboundgate.so natively on arm64 hosts (docs/ANDROID.md). Go
# emulated on x86-64 is not reliable (the go command panics under qemu), and
# the NDK's own clang exists for x86-64 only. This stage therefore takes from
# the SDK image (./Dockerfile, tagged boundgate-android-build) only what does
# not run on the host: the NDK's sysroot and the compiler-rt libraries for
# Android targets. A native clang compiles and links against them.
FROM boundgate-android-build AS sdk

FROM --platform=linux/arm64 debian:trixie-slim@sha256:a99cfc517144bc59b1978475ec53b46ecabec7e43635402ee5b77cc54cd1b20a
RUN apt-get update && apt-get install -y --no-install-recommends clang lld curl ca-certificates \
	&& rm -rf /var/lib/apt/lists/*
COPY --from=sdk /opt/android-sdk/ndk/29.0.14206865/toolchains/llvm/prebuilt/linux-x86_64/sysroot /opt/ndk/sysroot
COPY --from=sdk /opt/android-sdk/ndk/29.0.14206865/toolchains/llvm/prebuilt/linux-x86_64/lib/clang/21 /opt/ndk/clang

# the same Go as the box (go.mod)
RUN curl -fsSLo /tmp/go.tgz https://go.dev/dl/go1.26.9.linux-arm64.tar.gz \
	&& echo "4a97373d49fcacdcf3694fea368a500b00ee3e963974f3e7514132717632f052  /tmp/go.tgz" | sha256sum -c - \
	&& tar -C /usr/local -xzf /tmp/go.tgz && rm /tmp/go.tgz
ENV PATH=/usr/local/go/bin:$PATH GOTOOLCHAIN=local GOPROXY=off GOFLAGS=-mod=vendor GOCACHE=/cache/go-core
