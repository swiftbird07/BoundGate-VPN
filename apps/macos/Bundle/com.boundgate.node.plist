<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- LaunchDaemon inside BoundGate.app (Contents/Library/LaunchDaemons), registered by the
     app through SMAppService. BundleProgram is relative to the bundle; the daemon finds its
     configuration in Contents/Resources/node.yaml. -->
<plist version="1.0">
<dict>
	<key>Label</key><string>@BUNDLE_ID@.node</string>
	<key>BundleProgram</key><string>Contents/MacOS/boundgate-node</string>
	<key>AssociatedBundleIdentifiers</key><array><string>@BUNDLE_ID@</string></array>
	<key>RunAtLoad</key><true/>
	<key>KeepAlive</key><true/>
	<key>ProcessType</key><string>Interactive</string>
	<key>StandardErrorPath</key><string>/var/log/boundgate-node.log</string>
</dict>
</plist>
